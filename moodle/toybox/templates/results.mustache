{{!
    @template mod_toybox/results

    Each learner's results, one column per toy.

    Example context (json):
    {
        "toys": [{"label": "Wave Lab", "optional": false}, {"label": "Phase", "optional": true}],
        "rows": [
            {"name": "Sam Student", "cells": [
                {"done": true, "detail": "{\"correct\":true}", "when": "1/12/26, 10:00", "attempts": "2 attempts"},
                {"done": false}
            ]}
        ]
    }
}}
<div class="table-responsive">
    <table class="generaltable mod-toybox-results">
        <thead>
            <tr>
                <th scope="col">{{#str}} fullname {{/str}}</th>
                {{#toys}}
                    <th scope="col">{{label}}{{#optional}} <small class="text-muted">({{#str}} optional, mod_toybox {{/str}})</small>{{/optional}}</th>
                {{/toys}}
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <th scope="row">{{name}}</th>
                    {{#cells}}
                        <td>
                            {{#done}}
                                <span class="text-success" title="{{detail}}">✓</span> {{when}}
                                {{#attempts}} <small class="text-muted">({{attempts}})</small>{{/attempts}}
                            {{/done}}
                            {{^done}}<span class="text-muted">–</span>{{/done}}
                        </td>
                    {{/cells}}
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
