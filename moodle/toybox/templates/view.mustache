{{!
    @template mod_toybox/view

    The student view. The player (or standalone toy) is built by mod_toybox/view.

    Example context (json):
    {
        "rootid": "mod-toybox-1-page",
        "inline": false,
        "name": "Sine waves",
        "notice": "",
        "canedit": true,
        "editurl": "https://example.com/mod/toybox/edit.php?id=1",
        "viewurl": "https://example.com/mod/toybox/view.php?id=1",
        "notoys": false,
        "istoy": false,
        "review": {"message": "These toys were restored from a backup.", "url": "https://example.com/mod/toybox/review.php", "cmid": 1, "sesskey": "abc"},
        "configjson": "{}"
    }
}}
<div id="{{rootid}}" class="mod-toybox-view{{#inline}} mod-toybox-inline{{/inline}}" data-region="mod-toybox">
    {{#inline}}
        <div class="mod-toybox-inline-head">
            <h3 class="mod-toybox-inline-name">{{name}}</h3>
            <a class="small mod-toybox-openfull" href="{{viewurl}}">{{#pix}} e/fullscreen, core {{/pix}}{{#str}} openfullpage, mod_toybox {{/str}}</a>
            {{#canedit}}<a class="small" href="{{editurl}}">{{#str}} edittoys, mod_toybox {{/str}}</a>{{/canedit}}
        </div>
    {{/inline}}
    {{#canedit}}
        {{#notoys}}
            <div class="alert alert-info">
                {{#str}} notoysyet_editprompt, mod_toybox {{/str}}
                <a class="btn btn-primary btn-sm ms-2 ml-2" href="{{editurl}}">{{#str}} edittoys, mod_toybox {{/str}}</a>
            </div>
        {{/notoys}}
    {{/canedit}}
    {{#review}}
        <form class="alert alert-warning mod-toybox-review" method="post" action="{{url}}">
            <span>{{message}}</span>
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <a class="btn btn-secondary btn-sm ms-2 ml-2" href="{{editurl}}">{{#str}} edittoys, mod_toybox {{/str}}</a>
            <button type="submit" class="btn btn-primary btn-sm ms-2 ml-2">{{#str}} markreviewed, mod_toybox {{/str}}</button>
        </form>
    {{/review}}
    {{#notice}}
        <div class="alert alert-warning">{{notice}}</div>
    {{/notice}}
    {{^notice}}
        <div class="mod-toybox-stage"></div>
        <script type="application/json" class="mod-toybox-config">{{{configjson}}}</script>
    {{/notice}}
</div>
