{{!
    @template mod_toybox/editor

    The toy editor shell. The editor itself is built by mod_toybox/editor.

    Example context (json):
    {
        "rootid": "mod-toybox-editor-1",
        "intro": "Write a toy, or ask an AI to write one.",
        "viewurl": "https://example.com/mod/toybox/view.php?id=1",
        "configjson": "{}"
    }
}}
<p class="mod-toybox-editorintro">{{intro}} <a href="{{viewurl}}">{{#str}} backtoactivity, mod_toybox {{/str}}</a></p>
<div id="{{rootid}}" class="mod-toybox-editroot">
    <script type="application/json" class="mod-toybox-config">{{{configjson}}}</script>
</div>
