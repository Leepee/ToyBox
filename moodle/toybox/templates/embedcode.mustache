{{!
    @template mod_toybox/embedcode

    Embed code for editors (to put the activity in an iframe elsewhere).

    Example context (json):
    {
        "code": "<iframe src=\"https://example.com/mod/toybox/embed.php?id=1\"></iframe>"
    }
}}
<details class="mod-toybox-embedcode mt-4">
    <summary>{{#str}} embedcode, mod_toybox {{/str}}</summary>
    <p class="small text-muted mt-2">{{#str}} embedcode_help, mod_toybox {{/str}}</p>
    <textarea class="form-control font-monospace" rows="3" readonly onclick="this.select()">{{code}}</textarea>
</details>
